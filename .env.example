# ChartSpark EHR — Environment Variables
# Copy to .env.local and fill in values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PHI Encryption (generate with: openssl rand -base64 32)
PHI_ENCRYPTION_KEY=your-encryption-key-min-32-chars

# C9: Legacy encryption salt (required at startup and for decrypting legacy-format data)
# The app refuses to boot without this value.
# For existing deployments, set this to the previously hardcoded value.
# For new deployments, generate with: openssl rand -hex 16
ENCRYPTION_SALT=your-encryption-salt

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=ChartSpark <noreply@chartspark.app>

# Stripe (optional — billing features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Azure OpenAI (optional — AI features)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Azure OpenAI Whisper (optional — AI Scribe transcription)
# Set to the name of your Whisper model deployment. Defaults to 'whisper'.
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# Cron Secret
CRON_SECRET=your-cron-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode — MUST remain false except in explicitly scoped local dev.
# SEC-AUDIT-2026-04-10: The example shipped `true`, which was easy to copy
# verbatim into a production .env and silently enable demo fallbacks.
NEXT_PUBLIC_DEMO_MODE=false

# Demo login credentials (local dev only). JSON array consumed server-side by
# the login page — never exposed via NEXT_PUBLIC_*. Leaving this unset in any
# non-dev environment hides the demo credential buttons entirely.
# DEMO_LOGIN_CREDENTIALS=[{"label":"Admin","email":"admin@example.test","password":"CHANGE_ME"}]

# Scribe Service (optional — proxies /api/ai/* to external transcription service)
# SCRIBE_SERVICE_URL=https://scribe.your-domain.com
